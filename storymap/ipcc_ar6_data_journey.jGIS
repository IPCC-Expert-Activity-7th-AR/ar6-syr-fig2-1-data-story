  "8245c026-e5d2-49ad-9a36-d146ac0ac0ee": {
   "name": "Step 3 · CEDA Harwell – the chapter-level chain",
   "type": "StorySegmentLayer",
   "visible": true,
   "parameters": {
    "zoom": 11.5,
    "extent": [
     -178703.29552287914,
