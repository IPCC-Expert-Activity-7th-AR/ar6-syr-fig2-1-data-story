 "stories": {
  "d07c6ca0-cd3d-4254-94c2-39382fab0853": {
   "title": "IPCC AR6 SYR Figure 2.1 – the data journey",
   "storyType": "guided",
   "presentationBgColor": "#0b2545",
   "presentationTextColor": "#eef4ed",
   "showGradient": true,
   "storySegments": [
    "eedc32ac-6ba2-46b5-b7ea-6999e0b15673",
    "e08f796b-bacd-4103-a242-bbf2828a054c",
    "4e0c6178-e2d7-4910-8c11-d9742a0cdb62",
