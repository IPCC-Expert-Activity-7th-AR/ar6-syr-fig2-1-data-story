  "253187fe-ab5b-4d0f-b767-378f3e1b2902": {
   "name": "Step 4 · CIESIN / SEDAC – SYR final data (panels c, d)",
   "type": "StorySegmentLayer",
   "visible": true,
   "parameters": {
    "zoom": 11.5,
    "extent": [
     -8260275.688132955,
     4991312.024424727,
